APP_NAME=module-agent
APP_ENV=development
API_PREFIX=/api
API_PORT=8000
LITERATURE_SOURCES=["openalex", "semantic_scholar"]
LITERATURE_HTTP_TIMEOUT_SECONDS=30
LITERATURE_HTTP_MAX_CONNECTIONS=20
OPENALEX_API_KEY=

SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_CIRCUIT_FAILURE_THRESHOLD=1
SEMANTIC_SCHOLAR_CIRCUIT_RECOVERY_SECONDS=60

GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_TIMEOUT_SECONDS=30

POSTGRES_USER=module_agent
POSTGRES_PASSWORD=module_agent_dev
POSTGRES_DB=module_agent
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://module_agent:module_agent_dev@localhost:5432/module_agent
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

RABBITMQ_USER=module_agent
RABBITMQ_PASSWORD=module_agent_dev
RABBITMQ_VHOST=module_agent
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692
RABBITMQ_URL=amqp://module_agent:module_agent_dev@localhost:5672/module_agent

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.7-plus


LITERATURE_QUERY_PLANNER=qwen
LITERATURE_RELEVANCE_SCORER=qwen
LITERATURE_METHOD_EXTRACTOR=qwen
QWEN_CALL_TIMEOUT_SECONDS=180


LANGGRAPH_DATABASE_URL=postgresql://module_agent:module_agent_dev@localhost:5432/module_agent
LANGGRAPH_STRICT_MSGPACK=true


CODE_WORKSPACE_ROOT=./data/code-workspaces
CODE_REPOSITORY_CONFIDENCE_THRESHOLD=0.7
CODE_REPOSITORY_SEARCH_LIMIT=10
CODE_PDF_MAX_BYTES=26214400
CODE_PDF_TIMEOUT_SECONDS=30
CODE_PDF_PARSE_TIMEOUT_SECONDS=15
CODE_PDF_MAX_PAGES=200
CODE_PDF_PARSE_MEMORY_BYTES=536870912
CODE_LANDING_PAGE_MAX_BYTES=2097152
GIT_CLONE_TIMEOUT_SECONDS=120

# Leave empty to keep validation static-only. Set this to an image already
# available to Docker before requesting sandbox validation.
VALIDATION_SANDBOX_IMAGE=
VALIDATION_GIT_TIMEOUT_SECONDS=10
WORKFLOW_TIMEOUT_SECONDS=3600

# Optional operations and dashboards.
CODE_WORKSPACE_RETENTION_DAYS=14
CODE_WORKSPACE_TRASH_RETENTION_DAYS=7
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=module_agent_dev

# rule: only deterministic decisions
# jev_shadow: rules execute; Jev decisions are observed only
# jev_guarded: Jev may only veto a retry with high-confidence stop advice
SUPERVISOR_POLICY=jev_shadow

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=3
JEV_CONFIDENCE_THRESHOLD=0.8
JEV_READINESS_MINIMUM_OBSERVATIONS=100
JEV_READINESS_MINIMUM_SUCCESS_RATE=0.95
